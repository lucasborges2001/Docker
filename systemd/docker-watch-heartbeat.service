[Unit]
Description=Docker Watch heartbeat snapshot
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/opt/docker-watch/config/server.env
EnvironmentFile=-/etc/docker-watch/docker-watch.env
ExecStart=/opt/docker-watch/bin/docker-heartbeat
User=root
Group=root
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/docker-watch /var/log/docker-watch /opt/docker-watch
