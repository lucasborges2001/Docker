# Docker Watch-only example for the private systemd EnvironmentFile:
# /home/tecnicosfivisa/servidor/config/docker/server.env
# Do not commit the populated server.env or copy legacy /opt configuration.
DOCKER_SERVIDOR_ROOT=/home/tecnicosfivisa/servidor
BASE_DIR=/home/tecnicosfivisa/servidor/current/base
DOCKER_WATCH_STATE_DIR=/home/tecnicosfivisa/servidor/state/docker
DOCKER_WATCH_REPORTS_DIR=/home/tecnicosfivisa/servidor/state/docker/reports
DOCKER_WATCH_EVENTS_LOG=/home/tecnicosfivisa/servidor/logs/docker/events.jsonl
DOCKER_WATCH_ENABLED=true
DOCKER_TELEMETRY_ENABLED=true
HEARTBEAT_ENABLED=true
HEARTBEAT_ONCE_PER_DAY=true
SEND_TELEGRAM=false
