DOCKER_WATCH_ENABLED=true
DOCKER_WATCH_REPORTS_DIR=/var/lib/docker-watch/reports
DOCKER_WATCH_STATE_DIR=/var/lib/docker-watch
DOCKER_WATCH_EVENTS_LOG=/var/log/docker-watch/events.jsonl
DOCKER_WATCH_RETENTION_DAYS=14

BASE_DIR=/opt/base

MONITOR_LABEL=dockwatch.monitor=true
RECOVERY_GRACE_SEC=60
HEARTBEAT_ENABLED=true
HEARTBEAT_ONCE_PER_DAY=true
SEND_TELEGRAM=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PARSE_MODE=HTML
TELEGRAM_DISABLE_NOTIFICATION=false
TELEGRAM_TIMEOUT_SECONDS=15
TELEGRAM_RETRY_ATTEMPTS=3
TELEGRAM_RETRY_SLEEP_SECONDS=2

BOT_TOKEN=
CHAT_ID=
