#!/usr/bin/env bash
set -euo pipefail
DOCKER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
docker_resolve_base_dir_shell() {
  if [[ -n "${BASE_DIR:-}" && -f "$BASE_DIR/lib/shell/env.sh" ]]; then printf '%s\n' "$BASE_DIR"; return 0; fi
  local candidate parent; parent="$(cd "$DOCKER_DIR/.." 2>/dev/null && pwd)"
  for candidate in "$DOCKER_DIR/../Base" "$parent/Base" "/opt/base"; do [[ -f "$candidate/lib/shell/env.sh" ]] && { printf '%s\n' "$candidate"; return 0; }; done
  return 1
}
docker_load_base_and_module_shell() {
  BASE_DIR="$(docker_resolve_base_dir_shell)" || { echo "Unable to resolve Base. Set BASE_DIR=/opt/base or keep Base next to Docker." >&2; exit 2; }
  export BASE_DIR DOCKER_DIR
  source "$BASE_DIR/lib/shell/env.sh"; source "$BASE_DIR/lib/shell/log.sh"; source "$BASE_DIR/lib/shell/json.sh"; source "$BASE_DIR/lib/shell/lock.sh"; source "$BASE_DIR/lib/shell/time.sh"; source "$BASE_DIR/lib/shell/telegram.sh"
  source "$DOCKER_DIR/lib/shell/collect.sh"; source "$DOCKER_DIR/lib/shell/render.sh"; source "$DOCKER_DIR/lib/shell/persist.sh"
  base_env_load_file "$DOCKER_DIR/.env"; base_env_load_file "$DOCKER_DIR/config/server.env"; base_env_load_file "/etc/docker-watch/docker-watch.env"
}
usage() { echo "Usage: docker-telemetry [--env FILE] [--reports-dir DIR] [--once|--loop] [--print]"; }
MODE=once; PRINT=false; EXTRA_ENV=""
while [[ $# -gt 0 ]]; do case "$1" in --env) EXTRA_ENV="${2:?}"; shift 2;; --reports-dir) export DOCKER_WATCH_REPORTS_DIR="${2:?}"; shift 2;; --once) MODE=once; shift;; --loop) MODE=loop; shift;; --print) PRINT=true; shift;; -h|--help) usage; exit 0;; *) echo "Unknown argument: $1" >&2; exit 2;; esac; done
docker_load_base_and_module_shell; [[ -n "$EXTRA_ENV" ]] && base_env_load_file "$EXTRA_ENV"
[[ "$(base_env_bool DOCKER_TELEMETRY_ENABLED true)" != true ]] && { base_log_info "Docker telemetry disabled"; exit 0; }
DOCKER_WATCH_REPORTS_DIR="${DOCKER_WATCH_REPORTS_DIR:-/var/lib/docker-watch/reports}"; DOCKER_WATCH_STATE_DIR="${DOCKER_WATCH_STATE_DIR:-/var/lib/docker-watch}"
interval="${DOCKER_TELEMETRY_INTERVAL_SECONDS:-60}"; [[ "$interval" =~ ^[0-9]+$ ]] || interval=60; (( interval < 5 )) && interval=5
collect_once() {
  local json="" summary="" result=0
  base_lock_acquire "$DOCKER_WATCH_STATE_DIR/docker-telemetry.lock" 5 DOCKER_TELEMETRY_LOCK_FD || return 75
  json="$(docker_collect_snapshot_json)" || result=$?
  if (( result == 0 )); then summary="$(docker_render_summary_text "$json")" || result=$?; fi
  if (( result == 0 )); then docker_persist_snapshot "$json" "$summary" "$DOCKER_WATCH_REPORTS_DIR" || result=$?; fi
  if (( result == 0 )); then docker_prune_old_reports "$DOCKER_WATCH_REPORTS_DIR" || result=$?; fi
  base_lock_release "${DOCKER_TELEMETRY_LOCK_FD:-}"; DOCKER_TELEMETRY_LOCK_FD=""
  (( result == 0 )) || return "$result"
  [[ "$PRINT" == true ]] && printf '%s\n' "$json" || base_log_info "Docker telemetry snapshot generated"
}
if [[ "$MODE" == once ]]; then collect_once; exit $?; fi
trap 'exit 0' INT TERM
while true; do collect_once || base_log_warn "Docker telemetry collection failed"; sleep "$interval" & wait $!; done
